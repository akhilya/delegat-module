<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Delegat</RootNamespace>
    <BuildPlugins Condition="'$(BuildPlugins)' == ''">true</BuildPlugins>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Local test/build dumps. Default None is **/* — without this, GenerateWatchList glob-walks artifacts and hangs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;_build_checkplugins/**;BaseOutputPath=artifacts/**</DefaultItemExcludes>
    <!-- Canonical SemVer is root VERSION; Docker /p:InformationalVersion overrides when set. -->
    <VersionFilePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\VERSION'))</VersionFilePath>
    <InformationalVersion Condition="'$(InformationalVersion)' == '' And Exists('$(VersionFilePath)')">$([System.IO.File]::ReadAllText('$(VersionFilePath)').Trim())</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delegat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core + MySQL (Pomelo) -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Fido2" Version="4.0.0" />
    <!-- Fido2.Models 4.0.0 pulls 9.0.0; CVE-2026-26127 is patched in 9.0.14+. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.19" />
    <!-- Fido2.Models pulls System.Formats.Cbor 9.0.x; CVE-2026-118747 (.NET DoS) is patched in 9.0.24+. -->
    <PackageReference Include="System.Formats.Cbor" Version="9.0.24" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.17">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <!-- Keep Pomelo's transitive driver on the release patched for GHSA-473q-m89c-ghf8. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />

    <!-- ASP.NET Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.20" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
    <!-- Fido2 pulls IdentityModel.Tokens 8.x; JwtBearer still resolved System.IdentityModel.Tokens.Jwt 7.1.2, so ValidateToken missed exp (IDX10225). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />

    <!-- MinIO SDK -->
    <PackageReference Include="Minio" Version="6.0.5" />

    <!-- Image Processing -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="8.0.1" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.6" />

    <!-- AI provider SDKs (official) -->
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="OpenAI" Version="*" />
    <!-- Manual content-free AI turn traces. No ASP.NET request instrumentation. -->
    <PackageReference Include="Sentry" Version="6.12.1" />

    <!-- Development tools -->
    <PackageReference Include="Dumpify" Version="0.6.6" />

    <!-- Catalog scrape Chromium fallback when unofficial HTTP is blocked -->
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Enums\" />
    <Folder Include="Interfaces\" />
    <Folder Include="Migrations\" />
    <Folder Include="Infrastructure\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sdk\Delegat.Marketplace.SDK\Delegat.Marketplace.SDK.csproj" />
  </ItemGroup>

  <!-- Build plugins and copy their output to backend output directory -->
  <Target Name="CopyPlugins" AfterTargets="Build" Condition="'$(BuildPlugins)' != 'false' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Ozon\Delegat.Marketplace.Ozon.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Wildberries\Delegat.Marketplace.Wildberries.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.OpenCart\Delegat.Marketplace.OpenCart.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.YandexMarket\Delegat.Marketplace.YandexMarket.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.WooCommerce\Delegat.Marketplace.WooCommerce.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Medusa\Delegat.Marketplace.Medusa.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Avito\Delegat.Marketplace.Avito.csproj" />
    </ItemGroup>
    <!-- SDK is already built via ProjectReference. Nested BuildProjectReferences=true races on deps.json. -->
    <MSBuild Projects="@(PluginProjects)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false;BuildProjectReferences=false" />
    <!-- Copy only the adapter projects we just built — not *Tests.dll under plugins/**/tests. -->
    <ItemGroup>
      <PluginDlls Include="..\plugins\Delegat.Marketplace.Ozon\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.Ozon.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.Wildberries\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.Wildberries.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.OpenCart\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.OpenCart.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.YandexMarket\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.YandexMarket.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.WooCommerce\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.WooCommerce.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.Medusa\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.Medusa.dll" />
      <PluginDlls Include="..\plugins\Delegat.Marketplace.Avito\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.Avito.dll" />
      <StalePluginDlls Include="$(OutputPath)plugins\*.Tests.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDlls)" DestinationFolder="$(OutputPath)plugins" SkipUnchangedFiles="true" />
    <Delete Files="@(StalePluginDlls)" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
