<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Delegat</RootNamespace>
    <BuildPlugins Condition="'$(BuildPlugins)' == ''">true</BuildPlugins>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Canonical SemVer is root VERSION; Docker /p:InformationalVersion overrides when set. -->
    <VersionFilePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\VERSION'))</VersionFilePath>
    <InformationalVersion Condition="'$(InformationalVersion)' == '' And Exists('$(VersionFilePath)')">$([System.IO.File]::ReadAllText('$(VersionFilePath)').Trim())</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delegat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core + MySQL (Pomelo) -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Fido2" Version="4.0.0" />
    <!-- Fido2.Models 4.0.0 pulls 9.0.0; CVE-2026-26127 is patched in 9.0.14+. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.17">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />

    <!-- ASP.NET Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.20" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />

    <!-- MinIO SDK -->
    <PackageReference Include="Minio" Version="6.0.5" />

    <!-- Image Processing -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="8.0.1" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.6" />

    <!-- AI provider SDKs (official) -->
    <PackageReference Include="Anthropic" Version="*-*" />
    <PackageReference Include="OpenAI" Version="*" />

    <!-- Development tools -->
    <PackageReference Include="Dumpify" Version="0.6.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Enums\" />
    <Folder Include="Interfaces\" />
    <Folder Include="Migrations\" />
    <Folder Include="Infrastructure\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sdk\Delegat.Marketplace.SDK\Delegat.Marketplace.SDK.csproj" />
  </ItemGroup>

  <!-- Build plugins and copy their output to backend output directory -->
  <Target Name="CopyPlugins" AfterTargets="Build" Condition="'$(BuildPlugins)' != 'false'">
    <ItemGroup>
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Ozon\Delegat.Marketplace.Ozon.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.Wildberries\Delegat.Marketplace.Wildberries.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.OpenCart\Delegat.Marketplace.OpenCart.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.YandexMarket\Delegat.Marketplace.YandexMarket.csproj" />
      <PluginProjects Include="..\plugins\Delegat.Marketplace.WooCommerce\Delegat.Marketplace.WooCommerce.csproj" />
    </ItemGroup>
    <!-- SDK is already built via ProjectReference. Nested BuildProjectReferences=true races on deps.json. -->
    <MSBuild Projects="@(PluginProjects)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false;BuildProjectReferences=false" />
    <ItemGroup>
      <PluginDlls Include="..\plugins\**\bin\$(Configuration)\$(TargetFramework)\Delegat.*.dll"
                  Exclude="..\plugins\**\bin\$(Configuration)\$(TargetFramework)\Delegat.Marketplace.SDK.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDlls)" DestinationFolder="$(OutputPath)plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
