# Delegat.Module — Environment Variables
# Copy to .env and fill in the values.
# See also: docs/platform/platform-link.md, docs/platform/capabilities.md

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose (prod): MYSQL_SERVER is set to `mysql` in compose itself.
# Local API outside Docker: use 127.0.0.1 + published port (default 3307).
# Prefer 127.0.0.1 over localhost on Windows — localhost often resolves to ::1 and
# misses Docker's IPv4 port publish.
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=delegat
MYSQL_USER=delegat

# ─── MinIO Object Storage ────────────────────────────────────────────────────
# Local: 127.0.0.1:9002 (docker-compose.yml maps 9002→9000)
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=delegat
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_SECURE=false
# Public host for marketplace/browser presigned URLs (host[:port] only — no scheme).
# CP-managed instances use storage.{label}.{INSTANCE_HOST_BASE}. Self-host: set to a
# Traefik/CDN host that reaches MinIO; leave empty to fall back to MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=storage.your-domain.com
MINIO_PUBLIC_SECURE=true

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_KEY=change_me_minimum_32_characters_long
JWT_ISSUER=your-domain.com
JWT_AUDIENCE=your-domain.com

# ─── Application ─────────────────────────────────────────────────────────────
# Required: AES-256 key as Base64 (exactly 32 bytes). Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=https://your-domain.com

# ─── Admin Seed (optional) ───────────────────────────────────────────────────
# If set, creates an admin user on first startup
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ─── Quotas / tariff flags (optional; set by Control Plane on provision) ──────
# Leave empty for unlimited (except AI_ENABLED — see below)
MAX_PRODUCTS=
MAX_STORAGE_GB=
MAX_FILES=
MAX_CONNECTIONS=
# true | false — AI assistant. Self-host: unset = enabled. CP-linked (CONTROL_PLANE_URL set): unset = disabled.
AI_ENABLED=
# true | false — Public API (/api/v1) usage. Self-host: unset = enabled. CP-linked: unset = disabled (Lite off, Pro+ on).
# Independent of PUBLIC_API_ENABLED (admin toggle). Both must be on for partner traffic.
API_USAGE_ENABLED=
# true | false — Plugin management page + custom DLL import. Self-host: unset = enabled. CP-linked: unset = disabled (Ops toggles).
# Built-in system marketplace adapters (Ozon, WB, …) always load regardless of this flag.
PLUGINS_ENABLED=

# Optional Python sandbox sidecar for the operator AI (run_python).
# Omit SANDBOX_URL (do not set SANDBOX_URL= empty) — an empty value disables the tool
# even when compose maps the sidecar. Local: http://127.0.0.1:8091
# Compose service `sandbox` is profile `ai` — it must not start when AI_ENABLED is false.
# pnpm dev reads AI_ENABLED from .env.dev and passes --profile ai only when AI is on.
# Self-host (AI on): docker compose -f docker-compose.prod.yml --profile ai up -d
#   SANDBOX_URL=http://127.0.0.1:8091   (local compose host port)
#   SANDBOX_AGENT_BASE_URL=http://host.docker.internal:5000
# Prod compose with --profile ai: API uses http://sandbox:8080 (not interpolated from this file)
#   SANDBOX_AGENT_BASE_URL=http://delegat-api:5000
# SANDBOX_URL=http://127.0.0.1:8091
SANDBOX_SECRET=
SANDBOX_AGENT_BASE_URL=http://host.docker.internal:5000
# Compose cgroup cap so a script cannot pin the host (half a CPU, 512 MiB, no extra swap).
# SANDBOX_CPUS=0.50
# SANDBOX_MEM_LIMIT=512m
# Job process (inside the sidecar): SANDBOX_CPU_THREADS=1 (max 2), SANDBOX_AS_MB=384, SANDBOX_TIMEOUT_SEC=30

# ─── Catalog scrape Chromium (Ozon / Yandex antibot fallback) ────────────────
# Unofficial HTTP JSON stays first. When the storefront returns captcha/403, the API
# opens the public page in Chromium (Playwright) and reuses the same parsers.
# Default channel is `chromium` (full Chrome headless, not chrome-headless-shell).
# Docker image already has browsers. Local Windows: first scrape installs Chromium
# automatically. To skip that (HTTP-only): CATALOG_SCRAPE_PLAYWRIGHT_INSTALL=false
# Manual: pwsh backend/bin/Debug/net8.0/playwright.ps1 install chromium
# Default: true. Set false to keep HTTP-only (storefront_blocked on antibot).
CATALOG_SCRAPE_PLAYWRIGHT=true
# Default: true. Download Chromium when Playwright reports the browser is missing.
CATALOG_SCRAPE_PLAYWRIGHT_INSTALL=true
# Default: true. Ozon is stricter on headless-shell; channel=chromium is the real browser.
# Set false on a desktop if you still get captcha (headed window).
CATALOG_SCRAPE_PLAYWRIGHT_HEADLESS=true
# Default: chromium (new headless). `chrome` = installed Google Chrome. `none` = headless-shell.
CATALOG_SCRAPE_PLAYWRIGHT_CHANNEL=chromium
# Optional HTTP(S) proxy for Chromium only, e.g. http://user:pass@host:8080
# Residential/mobile proxies help Ozon and Yandex Market more than datacenter IPs.
CATALOG_SCRAPE_PLAYWRIGHT_PROXY=
# Optional timeout ms (default 60000) and concurrent pages 1–4 (default 1)
# CATALOG_SCRAPE_PLAYWRIGHT_TIMEOUT_MS=60000
# CATALOG_SCRAPE_PLAYWRIGHT_CONCURRENCY=1

# ─── Retention (optional) ────────────────────────────────────────────────────
# Adapter HTTP logs retention (days), default 7
ADAPTER_HTTP_LOG_RETENTION_DAYS=7
# Export/import queue + operations history retention (days), default 7
QUEUE_RETENTION_DAYS=7

# ─── Persistent logging defaults (seed only) ─────────────────────────────────
# First boot seeds instanceLoggingSettings from these env vars.
# Afterwards toggles are controlled in Admin UI (/settings) without restart.
# Error logs (ExceptionMiddleware → MySQL). Default: true
LOG_ERRORS_ENABLED=true
# Public API /api/v1 activity log (includes request/response bodies). Default: false
LOG_API_REQUESTS_ENABLED=false
# Outbound marketplace adapter HTTP log. Default: false
LOG_ADAPTER_HTTP_ENABLED=false

# ─── Public API enablement (seed only) ───────────────────────────────────────
# First boot seeds instancePublicApiSettings. Afterwards: Admin UI → Public API.
# When false, /api/v1 returns 503 PUBLIC_API_DISABLED (no restart). Default: true
# Plan gate is API_USAGE_ENABLED above (Lite off). Both must be on for partner traffic.
PUBLIC_API_ENABLED=true

# ─── Branding / white-label (seed only) ──────────────────────────────────────
# First boot seeds instanceBrandingSettings. Afterwards: Settings → Branding (or Setup wizard).
# Empty BRAND_LOGO_URL = no logo (name-only). Empty BRAND_FAVICON_URL = CP square favicon.
# Colors are #RRGGBB when set.
# BRAND_NAME=Delegat.Module
# BRAND_DESCRIPTION=
# BRAND_LOGO_URL=
# BRAND_FAVICON_URL=/logo-square-favicon.webp
# BRAND_PRIMARY=#343434
# BRAND_ACCENT=#F7F7F7

# ─── MySQL (prod compose) ────────────────────────────────────────────────────
# InnoDB buffer pool size for docker-compose.prod.yml (default 256M)
# MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# ─── Platform Link (optional; SaaS provision injects these) ───────────────────
# Empty URL/secret = offline instance; reference catalogs stay empty until linked.
# Contract: docs/platform/platform-link.md
CONTROL_PLANE_URL=
INSTANCE_ID=
INSTANCE_LINK_SECRET=
# How often to refresh Reference Catalog from CP (minutes), default 360
PLATFORM_CATALOG_REFRESH_MINUTES=360
# Heartbeat interval to CP (minutes), default 5; skipped when link is off
PLATFORM_HEARTBEAT_MINUTES=5

# ─── Local Development ───────────────────────────────────────────────────────
# When running the API with ASPNETCORE_ENVIRONMENT=Development, Vite starts on :5173.
# `pnpm dev` already starts Vite in the [web] pane and sets this so the API does not spawn a second process.
# Set to 1/true yourself if you run `npm run dev` in frontend/ next to `dotnet watch`.
# SKIP_VITE_DEV_SERVER=1

# Public product docs base (Control Plane SPA /docs). Must be the public docs origin,
# not this instance’s Vite app (both default to :5173).
# Dev: set DOCS_PUBLIC_URL in repo-root `.env.dev` (Vite loads it for /runtime-config.js;
# the API also fetches catalog.json and article .md from this URL).
#   Example: DOCS_PUBLIC_URL=https://module.delegat.pro/docs
# Optional Vite-only override: VITE_DOCS_PUBLIC_URL in frontend/.env.development
# Docker / CP-provisioned instances: CP injects DOCS_PUBLIC_URL into the frontend container
# (written to /runtime-config.js at start; base is https://module.delegat.pro/docs).
# DOCS_PUBLIC_URL=https://module.delegat.pro/docs
# VITE_DOCS_PUBLIC_URL=https://module.delegat.pro/docs

# ─── Docker image tag (for production deploy) ────────────────────────────────
IMAGE_TAG=latest

# ─── Volume names (optional) ─────────────────────────────────────────────────
# Override to mount existing Docker volumes (e.g. migrating from another project).
# Leave unset to use default names: delegat-mysql-data, delegat-minio-data
# MYSQL_VOLUME_NAME=delegat-mysql-data
# MINIO_VOLUME_NAME=delegat-minio-data
