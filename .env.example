# Delegat.Module — Environment Variables
# Copy to .env and fill in the values.
# See also: docs/platform/platform-link.md, docs/platform/capabilities.md

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose (prod): MYSQL_SERVER is set to `mysql` in compose itself.
# Local API outside Docker: use localhost + published port (default 3307).
MYSQL_SERVER=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=delegat
MYSQL_USER=delegat

# ─── MinIO Object Storage ────────────────────────────────────────────────────
# Local: localhost:9002 (docker-compose.yml maps 9002→9000)
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=delegat
MINIO_ENDPOINT=localhost:9002
MINIO_SECURE=false
# Public URL used when generating download links (e.g. for marketplace image uploads)
MINIO_PUBLIC_ENDPOINT=https://storage.your-domain.com
MINIO_PUBLIC_SECURE=true

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_KEY=change_me_minimum_32_characters_long
JWT_ISSUER=your-domain.com
JWT_AUDIENCE=your-domain.com

# ─── Application ─────────────────────────────────────────────────────────────
# Required: AES-256 key as Base64 (exactly 32 bytes). Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=https://your-domain.com

# ─── Admin Seed (optional) ───────────────────────────────────────────────────
# If set, creates an admin user on first startup
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ─── Quotas / tariff flags (optional; set by Control Plane on provision) ──────
# Leave empty for unlimited (except AI_ENABLED — unset defaults to enabled)
MAX_PRODUCTS=
MAX_STORAGE_GB=
MAX_FILES=
MAX_CONNECTIONS=
# true | false — AI assistant; unset = enabled (backward compatible)
AI_ENABLED=

# ─── Retention (optional) ────────────────────────────────────────────────────
# Adapter HTTP logs retention (days), default 7
ADAPTER_HTTP_LOG_RETENTION_DAYS=7
# Export/import queue + operations history retention (days), default 7
QUEUE_RETENTION_DAYS=7

# ─── Platform Link (optional; SaaS provision injects these) ───────────────────
# Empty URL/secret = offline instance; reference catalogs stay empty until linked.
# Contract: docs/platform/platform-link.md
CONTROL_PLANE_URL=
INSTANCE_ID=
INSTANCE_LINK_SECRET=
# How often to refresh Reference Catalog from CP (minutes), default 360
PLATFORM_CATALOG_REFRESH_MINUTES=360
# Heartbeat interval to CP (minutes), default 5; skipped when link is off
PLATFORM_HEARTBEAT_MINUTES=5

# ─── Docker image tag (for production deploy) ────────────────────────────────
IMAGE_TAG=latest

# ─── Volume names (optional) ─────────────────────────────────────────────────
# Override to mount existing Docker volumes (e.g. migrating from another project).
# Leave unset to use default names: delegat-mysql-data, delegat-minio-data
# MYSQL_VOLUME_NAME=delegat-mysql-data
# MINIO_VOLUME_NAME=delegat-minio-data
