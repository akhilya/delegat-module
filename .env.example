# PrintO Dashboard Environment Variables
# Copy this file to .env and fill in the values

# ======================
# Environment
# ======================
ASPNETCORE_ENVIRONMENT=Development

# ======================
# MySQL Database
# ======================
MYSQL_SERVER=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=printo
MYSQL_USER=printo
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ======================
# MinIO Object Storage
# ======================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=printo
MINIO_SECURE=false

# ======================
# JWT Authentication
# ======================
JWT_KEY=your_very_long_and_secure_jwt_key_at_least_32_characters
JWT_ISSUER=printo.studio
JWT_AUDIENCE=printo.studio

# ======================
# Frontend
# ======================
VITE_API_SERVER=http://localhost:5000

# ======================
# Admin Seed (optional)
# If all three are set, an admin user will be created on startup
# ======================
ADMIN_EMAIL=admin@printo.studio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123!

# ======================
# Production Settings
# ======================
# For production, change:
# - ASPNETCORE_ENVIRONMENT=Production
# - MYSQL_SERVER=your_external_mysql_server
# - MINIO_ENDPOINT=your_external_minio_endpoint
# - MINIO_SECURE=true
# - VITE_API_SERVER=https://api.printo.studio
