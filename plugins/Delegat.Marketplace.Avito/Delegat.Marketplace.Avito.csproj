<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delegat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(DelegatSdkProject)' != ''" Include="$(DelegatSdkProject)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Condition="'$(DelegatSdkProject)' == ''" Include="..\..\sdk\Delegat.Marketplace.SDK\Delegat.Marketplace.SDK.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
