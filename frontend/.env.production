VITE_API_SERVER=/api
VITE_BRAND_NAME=Delegat.Module
VITE_BRAND_DESCRIPTION=Delegat.Module — product and marketplace catalog control panel
# Leave unset for no default logo (name-only until upload)
# VITE_BRAND_LOGO=
VITE_BRAND_FAVICON=/logo-square-favicon.webp
# Optional Vite-only override. Prefer DOCS_PUBLIC_URL from the build/deploy environment.
# Docker entrypoint overwrites /runtime-config.js from DOCS_PUBLIC_URL at container start.
# VITE_DOCS_PUBLIC_URL=https://module.delegat.pro/docs
