VITE_API_SERVER=/api
VITE_BRAND_NAME=Delegat.Module
VITE_BRAND_DESCRIPTION=Delegat.Module — product and marketplace catalog control panel
# Leave unset for no default logo (name-only until upload)
# VITE_BRAND_LOGO=
VITE_BRAND_FAVICON=/logo-square-favicon.webp
# Optional: Vite-only override. Prefer repo-root `.env.dev` → DOCS_PUBLIC_URL
# (vite.config.js loads it into /runtime-config.js). Dev default: http://localhost:5174
# VITE_DOCS_PUBLIC_URL=http://localhost:5174
