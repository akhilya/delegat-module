<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M1 isolated prototype for the AI-runtime migration (docs/ai/assistant-dialog-issues.md §9.4).
    PROOF-ONLY: no ProjectReference to backend/Delegat.csproj, no production wiring.
    Everything runs against fake HttpMessageHandler transports — no live provider calls.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Delegat.AiRuntime.Tests</RootNamespace>
    <AssemblyName>backend.AiRuntime.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Pinned candidate runtime (M1): Microsoft Agent Framework + provider adapters. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <!-- Pinned explicitly for M1; backend/Delegat.csproj still floats OpenAI "*" (M3 pinning TODO). -->
    <PackageReference Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
